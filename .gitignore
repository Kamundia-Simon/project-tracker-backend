# Root-level ignores. backend/ and frontend/ keep their own .gitignore files,
# which git still reads for their subtrees.

# Scratch material that lives at the root while working — references, screenshots,
# WhatsApp exports. Anything worth keeping belongs in docs/assets/.
*.jpeg
*.jpg
*.png
*.mp4
!docs/assets/**

demo/

.DS_Store
Thumbs.db
